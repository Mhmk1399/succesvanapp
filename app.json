{
  "expo": {
    "name": "Success Van Hire",
    "slug": "success-van-hire",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/apple.png",
    "scheme": "succesvanapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.succesvanhire.app",
      "buildNumber": "1.0.0",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs access to your microphone to record voice messages for AI-powered booking assistance.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload your driving license for verification.",
        "NSCameraUsageDescription": "This app needs access to your camera to take a photo of your driving license for verification."
      }
    },
    "android": {
      "package": "com.succesvanhire.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#fe9a00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3d8a5a5-bfdf-405f-a0fa-f001d5dcc3d1"
      }
    },
    "owner": "successvan-organization",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c3d8a5a5-bfdf-405f-a0fa-f001d5dcc3d1"
    }
  }
}
